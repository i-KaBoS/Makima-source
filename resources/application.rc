#include <windows.h>
#include <winver.h>

#include "resource_ids.h"

LANGUAGE LANG_ENGLISH, SUBLANG_ENGLISH_US




IDR_STARTUP_CHECK_HTML RCDATA "embedded\\startup_check.html.xor"
IDR_APPLICATION_CSS RCDATA "embedded\\app.css.xor"
IDR_APPLICATION_JAVASCRIPT RCDATA "embedded\\app.js.xor"
IDR_APPLICATION_HTML RCDATA "embedded\\index.html.xor"
IDR_APPLICATION_LOGO RCDATA "embedded\\logo.png.xor"

IDR_VERSION_INFORMATION VERSIONINFO
 FILEVERSION 3,0,0,0
 PRODUCTVERSION 3,0,0,0
 FILEFLAGSMASK 0x0L
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN


            VALUE "CompanyName", " "
            VALUE "FileDescription", " "
            VALUE "FileVersion", "1.0.0.0"
            VALUE "ProductName", " "
            VALUE "ProductVersion", "1.0.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END

IDR_APPLICATION_MANIFEST RT_MANIFEST "application_manifest.xml"
